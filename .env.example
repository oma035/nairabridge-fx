# Quick start with no secrets:  npm install && npm run demo
# Demo mode simulates the Textile market and serves the board API on http://localhost:8787.
# It also switches on by itself on a fresh checkout (TELEGRAM_BOT_TOKEN and PUBLIC_URL both empty),
# but never on Render. Demo data always goes to ./data/demo.db, never to DB_PATH.
#
# Required for the real agent: TELEGRAM_BOT_TOKEN and PUBLIC_URL. Everything else has a default
# or is optional (marked below).

# ---- Hackathon ----
# ERC-8021 attribution code from your Loops House registration (celo_xxxxxxxxxxxx).
# This ONE value is appended to every transaction the project builds.
ATTRIBUTION_CODE=celo_f91a4dd61bbc

# ---- Chain ----
CELO_RPC_URL=https://forno.celo.org

# ---- Textile FX ----
TEXTILE_API_BASE=https://api.textilecredit.com
# Optional partner key (tx_live_...). Without it the API still works:
# previews need nothing, firm quotes need a takerProof signed by the user's wallet.
TEXTILE_API_KEY=

# ---- Agent wallet (only signs the agent's OWN txs, e.g. ERC-8004 registration) ----
# Never put a user's key here. Users always sign their own swaps.
AGENT_PRIVATE_KEY=
# (optional: only `npm run register-agent` needs these two)
# Public URL of the agent registration file (agent.json), used by register-agent
AGENT_URI=

# ---- Quote Sentinel ----
SENTINEL_INTERVAL_SEC=180
# Trade sizes in USD notional, comma separated
SENTINEL_SIZES_USD=10,50,200,1000
DB_PATH=./data/nairabridge.db

# ---- Reference rates (NGN per USD) ----
# Parallel market: "static" (manual value below) or "url" (JSON endpoint + dot path)
REF_PARALLEL_MODE=static
REF_PARALLEL_LABEL=Parallel market (manual)
REF_PARALLEL_STATIC=
REF_PARALLEL_URL=
REF_PARALLEL_PATH=
# Official / mid-market: same options
REF_OFFICIAL_MODE=url
REF_OFFICIAL_LABEL=Mid-market (open.er-api.com)
REF_OFFICIAL_URL=https://open.er-api.com/v6/latest/USD
REF_OFFICIAL_PATH=rates.NGN
REF_OFFICIAL_STATIC=

# ---- Telegram bot + web pages ----
# REQUIRED for the real agent (from @BotFather). Leave empty to start in demo mode.
TELEGRAM_BOT_TOKEN=
# REQUIRED for the real agent. Public HTTPS URL where this server is reachable (tunnel or Render URL), no trailing slash
PUBLIC_URL=
PORT=8787
# Optional: https://cloud.reown.com project ID, enables "Connect wallet" (Valora, MetaMask, others)
WALLETCONNECT_PROJECT_ID=
# Explorer API used to check users' first Celo activity (hackathon eligibility)
EXPLORER_API=https://celo.blockscout.com/api
# Set to 0 if you run `npm run sentinel` separately against the same database
RUN_SENTINEL=1
# Where GET / redirects (the public rate board)
BOARD_URL=https://nairabridgefx.lovable.app

# ---- Demo ----
# 1 = demo mode even if a bot token is set (simulated market, bot off, separate ./data/demo.db)
DEMO_MODE=
DEMO_DB_PATH=
