{
  "name": "nairabridge-fx",
  "version": "0.2.0",
  "private": true,
  "description": "AI agent on Celo that converts cNGN <-> USDT at the best Textile FX rate, with a public Quote Sentinel rate board",
  "type": "module",
  "scripts": {
    "build": "esbuild web/app.ts --bundle --format=esm --splitting --outdir=web/dist --entry-names=app --chunk-names=chunk-[hash] --minify --target=es2020 --platform=browser --define:global=globalThis --log-level=warning",
    "dev": "npm run build && tsx src/main.ts",
    "start": "npm run build && tsx src/main.ts",
    "demo": "npm run build && DEMO_MODE=1 tsx src/main.ts",
    "quote": "tsx scripts/quote-once.ts",
    "sentinel": "tsx src/sentinel/run.ts",
    "register-agent": "tsx scripts/register-agent.ts",
    "verify-tag": "tsx scripts/verify-tag.ts",
    "new-wallet": "tsx scripts/new-wallet.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsx test/e2e.mts && tsx test/board.mts && tsx test/alerts.mts && tsx test/groups.mts && tsx test/demo.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.5.0",
    "@walletconnect/ethereum-provider": "2.25.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.46.0",
    "tsx": "^4.20.0",
    "viem": "^2.57.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
